APP_NAME="Maruti Travels"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Database (MySQL 8 in production; local can use the same)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maruti_portal
DB_USERNAME=root
DB_PASSWORD=

# Sessions, cache, queue (database driver in v1 per HLD §9.4)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=database

# Filesystem
FILESYSTEM_DISK=local

# Mail (Brevo SMTP in production; local logs to file)
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bookings@marutitravels.example"
MAIL_FROM_NAME="${APP_NAME}"

# AI vision providers (HLD §13, LLD §13)
AI_ENABLED=false
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACK=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MONTHLY_CAP_INR=300
AI_CONFIDENCE_THRESHOLD=0.7

# PDF rendering (snappy primary, dompdf fallback per HLD §9.6)
SNAPPY_PDF_BINARY=/opt/homebrew/bin/wkhtmltopdf
SNAPPY_IMAGE_BINARY=/opt/homebrew/bin/wkhtmltoimage

# Off-server backup is disabled in v1; relying on Cloudways snapshots.
# Variables retained for future activation (HLD §9.10):
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=

VITE_APP_NAME="${APP_NAME}"
